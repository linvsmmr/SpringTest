<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.eunbi.springtest.ajax.repository.FavoriteRepository">

    <select id="selectFavoriteList"
            resultType="com.eunbi.springtest.ajax.domain.Favorites">
        SELECT
            `id`
             , `name`
             , `url`
             , `created_at`
             , `updated_at`
        FROM
            `favorite`
        ORDER BY
            `id` DESC
    </select>

    <insert id="insertFavorite" parameterType="map">
        INSERT INTO
            `favorite`
        (
          `name`
        , `url`
        )
            VALUE
            (
            #{name}
            , #{url}
            )
    </insert>

